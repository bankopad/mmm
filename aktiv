<html lang="ru"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Как оформить страницу ВКонтакте для МАВРО-АКТИВ 2.0</title>
  <style>
:root {
  --bg: #FDFBF7;
  --surface: #FFFFFF;
  --text: #2D2B2A;
  --text-muted: #7A7571;
  --accent: #D97736;
  --accent-hover: #BF6226;
  --border: #EAE6DF;
  --shadow: rgba(45, 43, 42, 0.05);
  --nav-bg: rgba(253, 251, 247, 0.95);
  --badge-minus: #C94A4A;
  --badge-plus: #2E8B57;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #1A1918;
    --surface: #242220;
    --text: #EBE9E4;
    --text-muted: #A39E99;
    --accent: #E08C53;
    --accent-hover: #F0A06C;
    --border: #383533;
    --shadow: rgba(0, 0, 0, 0.3);
    --nav-bg: rgba(26, 25, 24, 0.95);
    --badge-minus: #E57373;
    --badge-plus: #4CAF50;
  }
}

*, *::before, *::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

html, body {
  width: 100%;
  max-width: 100%;
  overflow-x: clip;
  margin: 0;
  padding: 0;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  font-size: 18px;
}

/* === Навигация === */
.top-nav {
  position: sticky;
  top: 0;
  width: 100%;
  z-index: 1000;
  background: var(--nav-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}

.nav-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 70px;
}

.nav-logo a {
  font-weight: 800;
  font-size: 1.35rem;
  color: var(--text);
  text-decoration: none;
  white-space: nowrap;
}

.nav-center {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  margin: 0 12px;
}

.nav-home-btn {
  opacity: 0;
  visibility: hidden;
  transform: translateY(-4px) scale(0.95);
  transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text);
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 6px 14px;
  border-radius: 20px;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
  box-shadow: 0 2px 8px var(--shadow);
}

.nav-home-btn:hover {
  color: var(--accent);
  border-color: var(--accent);
}

.nav-home-btn.visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-left: auto;
  margin-right: 24px;
}

.nav-links a {
  font-size: 0.95rem;
  color: var(--text-muted);
  text-decoration: none;
  font-weight: 500;
  white-space: nowrap;
}

.nav-links a:hover {
  color: var(--text);
}

/* === Кнопка регистрации === */
.btn-register {
  position: relative;
  background: var(--accent);
  color: #fff !important;
  height: 40px;
  min-width: 145px;
  padding: 0 16px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.9rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(217, 119, 54, 0.25);
  border: none !important;
  flex-shrink: 0;
}

.btn-register:hover {
  background: var(--accent-hover);
}

.btn-register::before {
  content: '';
  position: absolute;
  top: 0;
  left: -120%;
  width: 50%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  transform: skewX(-20deg);
  animation: btnShimmer 7s infinite ease-in-out;
  pointer-events: none;
}

@keyframes btnShimmer {
  0%, 72% { left: -120%; }
  82%, 100% { left: 180%; }
}

.btn-txt-reg, .btn-txt-promo {
  position: absolute;
  white-space: nowrap;
}

.btn-txt-reg {
  animation: animReg 7s infinite ease-in-out;
}

.btn-txt-promo {
  animation: animPromo 7s infinite ease-in-out;
}

@keyframes animReg {
  0%, 46% { opacity: 1; transform: translateY(0); }
  52%, 94% { opacity: 0; transform: translateY(-8px); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes animPromo {
  0%, 46% { opacity: 0; transform: translateY(8px); }
  52%, 94% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(8px); }
}

/* === Структура === */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 20px 80px;
  display: flex;
  gap: 50px;
  align-items: flex-start;
  width: 100%;
}

.content {
  flex: 1;
  min-width: 0;
  background: var(--surface);
  padding: 50px 60px;
  border-radius: 20px;
  box-shadow: 0 10px 40px var(--shadow);
  border: 1px solid var(--border);
  overflow-wrap: break-word;
}

article {
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.sidebar {
  width: 280px;
  flex-shrink: 0;
  position: sticky;
  top: 100px;
  max-height: calc(100vh - 120px);
  overflow-y: auto;
}

.toc {
  background: var(--surface);
  padding: 24px;
  border-radius: 16px;
  border: 1px solid var(--border);
}

.toc h3 {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  margin: 0 0 14px 0;
}

.toc ul {
  list-style: none;
  padding: 0;
  margin: 0;
  border-left: 2px solid var(--border);
}

.toc a {
  color: var(--text-muted);
  text-decoration: none;
  font-size: 0.9rem;
  display: block;
  padding: 6px 0 6px 14px;
}

.toc a:hover {
  color: var(--accent);
  border-left: 2px solid var(--accent);
  margin-left: -2px;
}

h1, h2, h3 {
  color: var(--text);
  font-weight: 700;
  line-height: 1.3;
}

h1 {
  font-size: 2.2rem;
  margin-top: 0;
  margin-bottom: 0.8em;
  letter-spacing: -0.02em;
}

h2 {
  font-size: 1.5rem;
  margin: 1.8em 0 0.8em;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--border);
}

h3 {
  font-size: 1.2rem;
  margin: 1.4em 0 0.6em;
}

p {
  margin: 0 0 1.3em;
  overflow-wrap: break-word;
}

ol, ul {
  margin: 0 0 1.4em;
  padding-left: 26px;
}

li {
  margin-bottom: 0.5em;
}

a {
  color: var(--accent);
  text-decoration: none;
  word-break: break-word;
}

a:hover {
  text-decoration: underline;
}

hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 2.2em 0;
}

.badge-minus {
  display: inline-block;
  color: var(--badge-minus);
  font-weight: 700;
}

.link-vk {
  font-weight: 600;
  word-break: break-all;
}

/* === Плашки внимания === */
.callout {
  margin: 1.8em 0;
  padding: 1.3em 1.6em;
  border-radius: 12px;
  background: var(--bg);
  border: 1px solid var(--border);
  overflow-wrap: break-word;
}

.callout > *:first-child { margin-top: 0 !important; }
.callout > *:last-child { margin-bottom: 0 !important; }

.callout h4 {
  margin: 0 0 0.4em;
  font-size: 1.05rem;
  color: var(--text);
}

.callout p {
  margin: 0;
  line-height: 1.55;
}

.callout p + p {
  margin-top: 0.7em;
}

.callout-blue   { background: rgba(74, 111, 165, 0.08); border-color: rgba(74, 111, 165, 0.25); }
.callout-amber  { background: rgba(217, 119, 54, 0.08); border-color: rgba(217, 119, 54, 0.25); }
.callout-purple { background: rgba(155, 107, 138, 0.08); border-color: rgba(155, 107, 138, 0.25); }
.callout-green  { background: rgba(74, 138, 111, 0.08); border-color: rgba(74, 138, 111, 0.25); }

/* === Мобильная адаптация === */
@media (max-width: 992px) {
  .container {
    flex-direction: column-reverse;
    padding: 16px 12px 60px;
    gap: 20px;
  }

  .sidebar {
    width: 100%;
    position: static;
    max-height: none;
  }

  .toc {
    padding: 18px;
  }

  .content {
    width: 100%;
    padding: 24px 16px;
    border-radius: 14px;
  }

  h1 {
    font-size: clamp(1.4rem, 5.5vw, 1.85rem);
  }

  h2 {
    font-size: 1.3rem;
  }

  .nav-container {
    flex-wrap: wrap;
    height: auto;
    padding: 10px 14px 8px;
    gap: 8px 0;
  }

  .nav-logo { order: 1; }
  .nav-center { order: 2; margin: 0 4px; }
  
  .btn-register {
    order: 3;
    height: 36px;
    min-width: 135px;
    font-size: 0.82rem;
    padding: 0 10px;
  }

  .nav-links {
    order: 4;
    width: 100%;
    margin: 8px 0 0;
    overflow-x: auto;
    padding: 0 4px 4px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 16px;
    display: flex;
    justify-content: flex-start;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }
}
  </style>
</head>
<body>

  

  <div class="container">
    <main class="content">
      <article>
