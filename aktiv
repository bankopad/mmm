    </main>

    
  </div>

  <script>
  (function() {
    var btn = document.getElementById('nav-home-btn');
    if (!btn) return;
    var isVis = false;
    window.addEventListener('scroll', function() {
      var y = window.pageYOffset || document.documentElement.scrollTop;
      if (y > 220) {
        if (!isVis) { btn.classList.add('visible'); isVis = true; }
      } else {
        if (isVis) { btn.classList.remove('visible'); isVis = false; }
      }
    }, { passive: true });
  })();
  </script>

